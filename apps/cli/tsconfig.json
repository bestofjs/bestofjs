{
  "compilerOptions": {
    "lib": ["esnext"],
    "target": "es2022",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "types": ["bun"]
  },
  "include": ["src/**/*.ts"]
}

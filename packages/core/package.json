{
  "name": "@repo/core",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "dotenv -e ../../.env.${STAGE:=development} pnpm drizzle-kit generate",
    "migrate": "dotenv -e ../../.env.${STAGE:=development} pnpm drizzle-kit migrate",
    "push": "dotenv -e ../../.env.${STAGE:=development} pnpm drizzle-kit push",
    "studio": "dotenv -e ../../.env.${STAGE:=development} pnpm drizzle-kit studio",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --incremental --watch",
    "lint": "biome check ./src",
    "lint:fix": "biome check --write ./src"
  },
  "exports": {
    ".": "./src/index.ts",
    "./drizzle": "./src/drizzle.ts",
    "./schema": "./src/schema.ts",
    "./constants": "./src/constants.ts",
    "./shared-schemas": "./src/shared-schemas.ts",
    "./services/projects": "./src/services/projects/index.ts",
    "./services/tags": "./src/services/tags/index.ts",
    "./services/snapshots": "./src/services/snapshots/index.ts",
    "./services/hall-of-fame": "./src/services/hall-of-fame/index.ts",
    "./services/project-trends": "./src/services/project-trends/index.ts",
    "./services/repo-trends": "./src/services/repo-trends/index.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "0.9.5",
    "@types/debug": "catalog:",
    "@types/luxon": "^3.7.1",
    "debug": "^4.4.1",
    "dotenv-cli": "catalog:",
    "drizzle-kit": "^0.31.4",
    "drizzle-orm": "^0.45.2",
    "es-toolkit": "^1.39.10",
    "is-absolute-url": "^4.0.1",
    "luxon": "^3.7.1",
    "nanoid": "^5.1.5",
    "slugify": "^1.6.6",
    "tiny-invariant": "^1.3.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@clack/prompts": "^0.11.0",
    "@types/bun": "^1.2.21",
    "postgres": "^3.4.9"
  }
}
